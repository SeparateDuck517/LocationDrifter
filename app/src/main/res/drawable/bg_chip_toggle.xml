<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_disabled_bg" />
            <corners android:radius="11dp" />
            <stroke
                android:width="1dp"
                android:color="@color/border_subtle" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_checked_bg" />
            <corners android:radius="11dp" />
            <stroke
                android:width="1.2dp"
                android:color="@color/chip_checked_border" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/chip_normal_bg" />
            <corners android:radius="11dp" />
            <stroke
                android:width="1dp"
                android:color="@color/border_subtle" />
        </shape>
    </item>
</selector>
